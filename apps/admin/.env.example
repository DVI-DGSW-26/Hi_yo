# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#
# VITE_ 값은 번들에 평문으로 들어간다. 시크릿을 넣지 않는다.

# 개발 서버. 주소는 시크릿이 아니다.
VITE_API_BASE_URL=http://112.146.55.78:3378/hi-yo

# 개발용 스텁 인증 (src/lib/devAuth.ts). 개발 모드에서만 쓰인다.
# 서버가 사내 OAuth 로 바뀌면 이 줄과 devAuth.ts 를 같이 지운다.
#   1 = 관리팀 / 3 = 관리팀(결재 2단계) / 2 = 일반 직원
# 관리팀 화면이므로 1 또는 3 을 쓴다. 2 로 두면 목록 조회가 403 으로 막힌다.
VITE_DEV_EMPLOYEE_ID=1
