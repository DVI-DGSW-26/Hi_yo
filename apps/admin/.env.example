# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#
# VITE_ 값은 번들에 평문으로 들어간다. 시크릿을 넣지 않는다.

# 개발 서버. 주소는 시크릿이 아니다.
#
# 로그인도 이 주소를 쓴다 — `lib/auth.ts` 가 여기에
# `/oauth2/authorization/keycloak` 을 붙여 브라우저를 통째로 보낸다.
VITE_API_BASE_URL=https://api.dvi-ind.com/hi-yo

# 인증에 넣을 값은 없다.
#
# DVI 통합 로그인(Keycloak)을 쓴다. 토큰은 로그인 후 서버가
# `<프런트>/auth/callback#token=...` 으로 돌려주고, sessionStorage 에 보관한다.
# 클라이언트 ID·시크릿은 서버가 갖고 있고 프런트는 알 필요가 없다.
#
# 로그인이 완주하려면 **콜백 주소가 서버에 등록돼 있어야 한다.**
# 개발용은 http://localhost:5173/auth/callback 이다.
# 등록 전에는 로그인 후 돌아오지 못한다 — 서버에 주소를 알려야 한다.
#
# 그리고 **테스트 계정의 Keycloak 아이디를 서버가 인사 정보에 연결해 둬야 한다.**
# 연결 전에는 로그인에 성공해도 모든 API 가 401 이다 (로그인만으로 직원을 만들지 않는다).
