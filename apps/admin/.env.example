# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#
# VITE_ 값은 번들에 평문으로 들어간다. 시크릿을 넣지 않는다.

# 개발 서버. 주소는 시크릿이 아니다.
VITE_API_BASE_URL=https://api.dvi-ind.com/hi-yo

# 개발용 스텁 인증 (src/lib/devAuth.ts). 개발 모드에서만 쓰인다.
# 서버가 사내 OAuth 로 바뀌면 이 줄과 devAuth.ts 를 같이 지운다.
#
# 관리팀 화면이므로 **부서가 `관리`인 재직 직원의 id** 를 넣는다.
# 아닌 id 를 넣으면 목록 조회가 403 으로 막힌다.
#
# id 는 시드 데이터라서 서버를 다시 심으면 바뀐다. 실제로 2026-08-28 에 한 번 바뀌었고,
# 그전에 쓰던 1 은 지금 401 이다. 안 되면 아래처럼 찾는다.
#
#   curl -H 'X-Debug-Employee-No: employee:<id>' \
#        https://api.dvi-ind.com/hi-yo/employees?size=1
#   200 이면 관리팀, 403 이면 일반 직원, 401 이면 없는 id 다.
#
# 비워 두면 헤더를 붙이지 않고 서버의 기본 사용자로 인증된다. 2026-08-28 기준 그 사용자도
# 관리팀이라 화면은 뜨지만, 누구로 보고 있는지 드러나지 않으므로 id 를 적어 두는 편이 낫다.
#
# 2026-08-28 확인 — 58, 4 가 관리팀이다.
VITE_DEV_EMPLOYEE_ID=58
