# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#
# EXPO_PUBLIC_ 값은 앱 번들에 평문으로 들어간다. 시크릿을 넣지 않는다.

# 개발 서버. 주소는 시크릿이 아니다.
#
# 로그인도 이 주소를 쓴다 — `src/lib/auth.ts` 가 여기에
# `/oauth2/authorization/keycloak` 을 붙여 시스템 브라우저를 연다.
EXPO_PUBLIC_API_BASE_URL=https://api.dvi-ind.com/hi-yo

# 인증에 넣을 값은 없다.
#
# DVI 통합 로그인(Keycloak)을 쓴다. 로그인하면 서버가 앱 딥링크로 토큰을 돌려주고,
# 토큰은 expo-secure-store 에 보관한다 (AsyncStorage 를 쓰지 않는다).
#
# 로그인이 완주하려면 **앱 콜백 주소가 서버에 등록돼 있어야 한다.**
# 주소는 `Linking.createURL('auth/callback')` 이 만든다 — app.json 의 scheme 이 `hr` 이라
# 배포 빌드에서는 `hr://auth/callback` 이다.
#
# **경로 앞에 슬래시를 붙이지 않는다.** `'/auth/callback'` 으로 부르면 배포 빌드에서
# `hr:///auth/callback` (슬래시 3개) 이 나온다 — 2026-09-08 실기기에서 확인했다.
# 개발 빌드에서는 드러나지 않으니 고치기 전에 `src/lib/auth.ts` 의 주석을 읽는다.
# **개발 빌드에서는 앞부분이 달라진다.** 앱을 켜고 로그인 화면에서 실제 값을 확인한 뒤
# 그 값을 서버에 알려야 한다.
#
# 그리고 **테스트 계정의 Keycloak 아이디를 서버가 인사 정보에 연결해 둬야 한다.**
# 연결 전에는 로그인에 성공해도 모든 API 가 401 이다.

# DVI 통합 로그인(Keycloak). **앱은 여기에 직접 붙는다** (2026-09-10 전환).
#
# 그전에는 서버가 중계했다. 그 경로는 없어지지 않고 웹판이 계속 쓴다 — 앱만 옮겼다.
# 옮긴 이유는 갱신이다: 중계는 액세스 토큰만 줘서 15분마다 다시 로그인해야 했다.
#
# 둘 다 시크릿이 아니다. 공개 클라이언트라 시크릿 자체가 없다 (PKCE 로 대신한다).
# 값은 discovery 로 확인했다 (2026-09-09).
EXPO_PUBLIC_OIDC_ISSUER=https://api.dvi-ind.com/dauth/realms/dvi
EXPO_PUBLIC_OIDC_CLIENT_ID=hi-yo-app
