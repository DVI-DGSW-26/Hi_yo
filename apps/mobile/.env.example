# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
#
# EXPO_PUBLIC_ 값은 앱 번들에 평문으로 들어간다. 시크릿을 넣지 않는다.

# 개발 서버. 주소는 시크릿이 아니다.
EXPO_PUBLIC_API_BASE_URL=https://api.dvi-ind.com/hi-yo

# 개발용 스텁 인증 (src/lib/devAuth.ts). __DEV__ 빌드에서만 쓰인다.
# 서버가 사내 OAuth 로 바뀌면 이 줄과 devAuth.ts 를 같이 지운다.
#
# 본인용 앱이므로 **재직 중인 일반 직원의 id** 를 넣는다.
# 퇴사자 id 를 넣으면 홈이 "지금 들어갈 수 있는 화면이 없어요" 만 보여준다 (명세서 S-401).
#
# id 는 시드 데이터라서 서버를 다시 심으면 바뀐다. 실제로 2026-08-28 에 한 번 바뀌었고,
# 그전에 쓰던 2 는 지금 퇴사 상태다. 안 되면 아래처럼 찾는다.
#
#   curl -H 'X-Debug-Employee-No: employee:<id>' \
#        https://api.dvi-ind.com/hi-yo/employees/me
#   employmentStatus 가 ACTIVE 인지 본다.
#
# 2026-08-28 확인 — 90(개발), 89(품질) 가 재직 중인 일반 직원이다.
EXPO_PUBLIC_DEV_EMPLOYEE_ID=90
